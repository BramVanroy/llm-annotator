{
  "output_dir": "outputs/pipeline-qa",
  "verbose": true,
  "log_level": "INFO",
  "dataset": {
    "name": "stanfordnlp/imdb",
    "split": "test",
    "max_num_samples": 20
  },
  "client": {
    "provider": "vllm_offline",
    "model": "HuggingFaceTB/SmolLM2-135M-Instruct",
    "batch_size": 16,
    "init": {
      "max_model_len": 4096
    },
    "options": {
      "temperature": 0.7,
      "max_completion_tokens": 512
    }
  },
  "steps": [
    {
      "name": "write-qa",
      "prompt_file": "prompts/write_qa.md",
      "system_prompt_file": "prompts/system.md",
      "output_schema_file": "schemas/qa.json",
      "sort_by_length": true,
      "num_retries_invalid": 3,
      "filter_invalid": true,
      "rename": {
        "question": "question_v1",
        "answer": "answer_v1"
      }
    },
    {
      "name": "rate-qa",
      "prompt_file": "prompts/rate_qa.md",
      "output_schema_file": "schemas/rating.json",
      "num_retries_invalid": 3,
      "client": {
        "provider": "vllm_offline",
        "model": "HuggingFaceTB/SmolLM2-360M-Instruct",
        "options": {
          "temperature": 0.0,
          "max_completion_tokens": 256
        }
      }
    }
  ]
}
