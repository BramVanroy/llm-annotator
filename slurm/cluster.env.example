# Everything the SLURM scripts need to know about *your* cluster. Copy it once:
#
#   cp slurm/cluster.env.example slurm/cluster.env
#
# and edit. slurm/cluster.env is read automatically by submit_pipeline.sh and by
# both job scripts; to keep several clusters side by side, write one file each
# and pick one per run with CLUSTER_ENV=slurm/clusters/<cluster>.env.
#
# Nothing about the annotation belongs here -- models, prompts, pool sizes and
# `vllm serve` flags all live in the pipeline config. This file is only the
# allocation and the local environment.
#
# Every scalar below can be overridden for a single submission by setting it on
# the command line, which wins over this file:
#
#   SERVER_TIME=08:00:00 ./slurm/submit_pipeline.sh my-pipeline.yaml
#
# `sacctmgr show associations user=$USER` and `sinfo -o "%P %G %c"` tell you
# most of what the first two blocks want.

# --- Allocation ---------------------------------------------------------------

# Accounting/project to charge. Leave empty if your cluster does not use one.
SLURM_ACCOUNT=

# Partition (queue) for the two kinds of job: the vLLM servers and the
# in-process vLLM jobs go to GPU_PARTITION, the CPU-only annotation clients go
# to CPU_PARTITION. Leave either empty to accept the cluster's default.
GPU_PARTITION=
CPU_PARTITION=

# Wall time. Servers are cancelled by their client when the step is done, so
# SERVER_TIME is an upper bound rather than a reservation you pay for in full.
SERVER_TIME=04:00:00
CLIENT_TIME=05:00:00

# Cores. A GPU job asks for CPUS_PER_GPU per GPU it uses -- many clusters bill a
# fixed core share per accelerator, and asking for less wastes it. CLIENT_CPUS
# is what a CPU-only annotation job requests; it drives the client's thread
# pool, so keep it at least as large as the largest `num_proc` in your config.
CPUS_PER_GPU=8
CLIENT_CPUS=8

# GPUs on one node. One vLLM server is one job on one node, so this is the
# ceiling a step's engine.tensor_parallel_size is checked against before
# anything is submitted.
MAX_GPUS_PER_NODE=8

# How this cluster's Slurm is asked for GPUs: "gres" for --gres=gpu:N, "gpus"
# for --gpus-per-node=N. GPU_TYPE is the accelerator name on clusters that have
# more than one (--gres=gpu:a100:N); leave it empty when there is only one.
GPU_REQUEST=gres
GPU_TYPE=

# Most elements of a server array that may run at the same time
# (--array=1-N%MAX_CONCURRENT_SERVERS), for a site with a per-user GPU limit.
# Empty means no throttle. It must be at least the largest pool.min_servers in
# your config, because a client waits for that many servers to be up.
MAX_CONCURRENT_SERVERS=

# Anything else sbatch should get, per job kind: QoS, memory, constraints,
# reservations, whatever else your cluster expects. Bash arrays, one flag per
# element.
SERVER_SBATCH_ARGS=()
CLIENT_SBATCH_ARGS=()

# Command a server job runs to get the address other nodes reach it at. The
# default prints the short host name, which is right almost everywhere; a site
# whose compute nodes only resolve fully qualified names uses "hostname -f", and
# one with a separate fabric uses a command that prints that interface's
# address.
SERVER_HOST_CMD=hostname

# --- Model downloads ----------------------------------------------------------

# Whether to fetch every model this submission serves itself before any GPU is
# allocated, in one small CPU job per model that the first step then waits for.
# Off by default: the download needs a route to huggingface.co from the node
# that runs it, which not every site has, and a run against an already warm
# cache gains nothing. Turn it on when a pool on a cold cache would otherwise
# have all of its servers download the same weights at once.
MODEL_DOWNLOAD=0

# Partition and wall time for those jobs. DOWNLOAD_PARTITION defaults to
# CPU_PARTITION; name a different one at a site with a dedicated data-transfer
# or internet-facing queue.
DOWNLOAD_PARTITION=
DOWNLOAD_TIME=02:00:00

# --- Environment inside a job -------------------------------------------------

# Environment modules to load before anything else, space-separated. Ignored
# when the cluster has no `module` command.
CLUSTER_MODULES=

# Python environment. VENV_PATH is activated when it exists; UV_SYNC=1 runs
# `uv sync --frozen --no-install-project` first, which is worth it when the
# repo lives on a shared filesystem and the venv may be stale.
VENV_PATH=
UV_SYNC=0

# Toolkit module providing `nvcc`, loaded only when vLLM would otherwise have to
# JIT-compile a kernel without one. Leave empty if nvcc is already available or
# you install the prebuilt FlashInfer kernels (uv sync --group vllm-kernels).
CUDA_MODULE=

# Where job logs and pool directories are written. Defaults to <repo>/logs.
LOG_DIR=

# Replace the whole environment setup when modules-plus-venv does not describe
# your cluster -- conda, a container, a wrapper script of your own. Defining it
# disables the CLUSTER_MODULES / UV_SYNC / VENV_PATH handling above; it must
# leave `llm-annotate` and `vllm` on PATH.
#
# cluster_setup_env() {
#   module load Python/3.12 CUDA/12.8.0
#   source /projects/shared/llm-annotator/.venv/bin/activate
# }

# A container is the same escape hatch: define `llm-annotate` and `vllm` as
# shell functions. Every script sources this file, so define them at the TOP
# LEVEL, not inside cluster_setup_env. A function defined inside it only
# reaches the two job scripts, because submit_pipeline.sh never calls it, and
# that script needs `llm-annotate` too: it reads the config on the login node.
# Where a top-level function lives, all three find it, and the empty
# cluster_setup_env below keeps the default module-and-venv handling out of the
# way. The limits: the login node has to be able to run the container runtime,
# and the bind mounts have to cover the repo, the config, the output directory
# and the Hugging Face cache.
#
# SIF=/projects/shared/images/vllm-0.29.0.sif
# BINDS="/projects,/scratch-local"
# llm-annotate() { apptainer exec --nv -B "$BINDS" "$SIF" llm-annotate "$@"; }
# vllm()         { apptainer exec --nv -B "$BINDS" "$SIF" vllm "$@"; }
# cluster_setup_env() { :; }

# --- A worked example ---------------------------------------------------------
#
# Snellius (SURF), whose GPU nodes have four accelerators and bill 18 cores per
# A100, and whose energy monitoring is asked for per job:
#
#   SLURM_ACCOUNT=my_project
#   GPU_PARTITION=gpu_a100
#   CPU_PARTITION=rome
#   CPUS_PER_GPU=18
#   CLIENT_CPUS=16
#   MAX_GPUS_PER_NODE=4
#   CLUSTER_MODULES="2025"
#   CUDA_MODULE=CUDA/12.8.0
#   UV_SYNC=1
#   SERVER_SBATCH_ARGS=(--ear=on --ear-policy=monitoring)
#   MAX_CONCURRENT_SERVERS=4
